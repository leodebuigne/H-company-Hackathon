# Copier en .env (orchestrateur, à la racine) et en web/.env.local (Next.js).
# Ne jamais committer de vraies valeurs. En production web : variables d'environnement Vercel.

# --- Orchestrateur (membre 5) ---
# Briques factices (1) ou réelles (0)
USE_FAKE_AGENT=1
USE_FAKE_AI=1
USE_FAKE_APPROVALS=1
# Prénom de l'utilisateur, affiché dans le SMS au proche
PILOTE_USER_FIRST_NAME=
# Proches à contacter dans l'ordre : Prénom:+33..., séparés par des virgules (3 au maximum)
PILOTE_RELATIVES=
# Délai par proche en secondes (300 maximum, plus court pour un repas)
APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_TIMEOUT_SECONDS_REPAS=120
# Adresse de l'app web qui expose /api/approvals (Vercel, ou http://localhost:3000 en local)
APPROVALS_API_URL=
# Validation factice : réponse donnée (approved, denied, expired) et délai en secondes
PILOTE_FAKE_APPROVAL_DECISION=approved
PILOTE_FAKE_APPROVAL_DELAY_S=5
# Journal des étapes (JSON lignes, sans audio ni phrase prononcée)
PILOTE_JOURNAL_PATH=logs/journal.jsonl
# Adresse d'écoute de l'orchestrateur (ws://PILOTE_HOST:PILOTE_PORT/ws)
PILOTE_HOST=127.0.0.1
PILOTE_PORT=8000

# --- Secret partagé orchestrateur <-> web (en-tête Authorization: Bearer) ---
PILOTE_SHARED_SECRET=

# --- Agent H Company (membre 1) ---
# Nom lu automatiquement par le SDK hai-agents (doc H actuelle)
HAI_API_KEY=
# Plafond d'un paiement réel en euros (999 par défaut)
PILOTE_MAX_TOTAL_EUR=
# 1 = l'agent paie sans callback d'approbation de l'orchestrateur. Laisser vide en démo
PILOTE_AUTO_APPROVE=
# Site visé par catégorie ; plan B : mettre RAIL_DEMO_URL et REPAS_DEMO_URL
PILOTE_SITE_TRAIN=
PILOTE_SITE_REPAS=

# --- Hugging Face (membre 2) ---
HF_TOKEN=
# Modèles et réglages (facultatifs, valeurs par défaut dans orchestrator/ai/hf.py)
PILOTE_ASR_MODEL=
PILOTE_LLM_MODEL=
PILOTE_VLM_MODEL=
PILOTE_TTS_MODEL=
PILOTE_TTS_VOICE=
# Au-delà, speak() renvoie None et l'interface prend la voix du navigateur (secondes)
PILOTE_TTS_TIMEOUT_S=

# --- Validation des proches (membre 3) ---
# Adresse publique des pages /v/{token} envoyées par SMS
PUBLIC_VALIDATION_URL=
# Clé HMAC qui signe les liens /v/{token}
VALIDATION_LINK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Code d'accès à la page de secours /demo/approvals
DEMO_APPROVALS_CODE=

# --- Redis Upstash (validations + mémoire des sites) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Interface (membre 4) ---
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8000/ws

# --- Plan B : faux sites (si un vrai site bloque l'agent le jour de la démo) ---
RAIL_DEMO_URL=https://h-company-hackathon-rail-demo.vercel.app
REPAS_DEMO_URL=https://h-company-hackathon-repas-demo.vercel.app
