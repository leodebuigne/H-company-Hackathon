# Copier en .env (orchestrateur, à la racine) et en web/.env.local (Next.js).
# Ne jamais committer de vraies valeurs. En production web : variables d'environnement Vercel.

# --- Orchestrateur (membre 5) ---
# Briques factices (1) ou réelles (0)
USE_FAKE_AGENT=1
USE_FAKE_AI=1
# Journal des étapes (JSON lignes, sans audio ni phrase prononcée)
PILOTE_JOURNAL_PATH=logs/journal.jsonl
# Adresse d'écoute de l'orchestrateur (ws://PILOTE_HOST:PILOTE_PORT/ws)
PILOTE_HOST=127.0.0.1
PILOTE_PORT=8000
# Téléphone (voir docs/telephone.md) : avec un PILOTE_HOST autre que 127.0.0.1, un jeton est obligatoire.
# Au moins 24 caractères ; vide = tiré au hasard à chaque démarrage et affiché avec le lien d'appairage
PILOTE_TOKEN=
# Pages autorisées en plus de localhost, séparées par des virgules (l'interface sur Vercel)
PILOTE_ALLOWED_ORIGINS=
# Pour que le serveur affiche un lien d'appairage prêt à ouvrir : l'interface, et le serveur vu de l'extérieur (wss://…/ws)
PILOTE_WEB_URL=
PILOTE_PUBLIC_WS_URL=

# --- Agent H Company (membre 1) ---
# Nom lu automatiquement par le SDK hai-agents (doc H actuelle)
HAI_API_KEY=
# Plafond d'un paiement réel en euros (999 par défaut)
PILOTE_MAX_TOTAL_EUR=
# 1 = l'agent paie sans callback d'approbation de l'orchestrateur. Laisser vide en démo
PILOTE_AUTO_APPROVE=
# Coffre-fort H (identifiants des sites, saisis par H sans que l'agent les voie). Navigateur cloud seulement
PILOTE_H_VAULT_ID=
# 1 = reprendre le profil de navigateur H par défaut (déjà connecté via python -m orchestrator.agent_h.login_session)
PILOTE_H_DEFAULT_PROFILE=
# 1 = achat direct : choisir une option vaut ordre d'achat (pas de oui ni de relecture). Seul garde-fou : le total ne dépasse pas le prix choisi
PILOTE_DIRECT_BUY=
# Modèle Holo de l'agent H : holo4-27b (défaut, le plus capable) ou holo4-35b-a3b (le plus rapide)
PILOTE_H_MODEL=
# Secondes pendant lesquelles une session H reste ouverte entre deux étapes (900 par défaut, 0 = une session par étape)
PILOTE_H_IDLE_TIMEOUT_S=
# Code secret à 3 chiffres demandé à l'oral avant chaque achat (achat direct). Vide = pas de code
PILOTE_PURCHASE_CODE=
# SNCF Connect : 0 = formulaire Trains au lieu de la recherche rapide « Tout rechercher » (défaut, 2 fois plus rapide)
PILOTE_SNCF_QUICK_SEARCH=
# Texte de la page en plus de la capture (0 = coupé ; pas plus rapide sur SNCF)
PILOTE_H_PAGE_TEXT=
# Réflexion de l'agent H avant chaque clic : disabled, low (défaut, plus rapide), medium, xhigh, default
PILOTE_H_REASONING_EFFORT=
# Nombre d'options que l'agent cherche (3 par défaut, 8 au maximum)
PILOTE_MAX_OPTIONS=
# Site visé par catégorie ; plan B : mettre RAIL_DEMO_URL et REPAS_DEMO_URL
PILOTE_SITE_TRAIN=
PILOTE_SITE_REPAS=
# Site imposé pour les autres achats (vide conseillé : la personne nomme le site, ou Pilote le lui demande)
PILOTE_SITE_BOUTIQUE=

# --- Hugging Face (membre 2) ---
HF_TOKEN=
# Modèles et réglages (facultatifs, valeurs par défaut dans orchestrator/ai/hf.py)
PILOTE_ASR_MODEL=
PILOTE_LLM_MODEL=
PILOTE_VLM_MODEL=
PILOTE_TTS_MODEL=
PILOTE_TTS_VOICE=
# Fournisseur de la voix (deepinfra par défaut : fal-ai n'a que des voix anglaises)
PILOTE_TTS_PROVIDER=
# Délai de la voix Kokoro, 6 s par défaut ; au-delà, speak() renvoie None et l'interface prend la voix du navigateur (secondes)
PILOTE_TTS_TIMEOUT_S=

# --- Mémoire des sites : fichier local par défaut (data/site-cards.json), ou Redis Upstash ---
PILOTE_SITE_MEMORY_PATH=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Interface (membre 4) ---
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8000/ws

# --- Plan B : faux sites (si un vrai site bloque l'agent le jour de la démo) ---
RAIL_DEMO_URL=https://h-company-hackathon-rail-demo.vercel.app
REPAS_DEMO_URL=https://h-company-hackathon-repas-demo.vercel.app

# Agent du portail H pour les questions (navigateur cloud, sous-agents de lecture), ex. pilote-shopper
PILOTE_H_QUESTION_AGENT=

# Voix de Pilote : huggingface (Kokoro en ligne, défaut), navigateur (voix de l'ordinateur), ou une voix française locale Kyutai : jerem (voix d'homme retenue pour la démo). Les voix locales demandent `pip install -e '.[voix]'` ; sans ce paquet, Pilote garde la voix en ligne
PILOTE_VOICE=

# Phrases de Pilote rédigées par le modèle de langage, faits vérifiés (1, défaut) ; 0 = phrases écrites d'avance
PILOTE_CONVERSATION=
# 0 = ne pas ouvrir le Chrome dédié au démarrage du serveur (par défaut il est ouvert tout de suite, pour que la première commande n'attende pas)
PILOTE_WARM_CHROME=
# 1 = plan B de la démo : train et repas passent par les faux sites de l'équipe (Rail Démo, Miam Démo) au lieu de SNCF Connect et Uber Eats
PILOTE_PLAN_B=
# --- Mémoire des chemins de l'agent (fichier local, jamais de donnée personnelle) ---
# 0 = coupée. Fichier : ~/.pilote/memoire-sites.json par défaut (supprimer le fichier = tout oublier)
PILOTE_MEMORY=
PILOTE_MEMORY_FILE=
