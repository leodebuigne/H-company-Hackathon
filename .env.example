# Copier en .env (orchestrateur, à la racine) et en web/.env.local (Next.js).
# Ne jamais committer de vraies valeurs. En production web : variables d'environnement Vercel.
# Une variable vide = valeur par défaut du code.

# =============================================================================
# Orchestrateur
# =============================================================================
# Briques factices (1) ou réelles (0). Réelles : un paiement accepté est une vraie commande
USE_FAKE_AGENT=1
USE_FAKE_AI=1
# Journal des étapes (JSON lignes, sans audio ni phrase prononcée)
PILOTE_JOURNAL_PATH=logs/journal.jsonl
# Adresse d'écoute de l'orchestrateur (ws://PILOTE_HOST:PILOTE_PORT/ws)
PILOTE_HOST=127.0.0.1
PILOTE_PORT=8000
# Phrases de Topil rédigées par le modèle de langage, faits vérifiés (1, défaut) ; 0 = phrases écrites d'avance
PILOTE_CONVERSATION=
# 0 = ne pas ouvrir le Chrome dédié au démarrage du serveur (par défaut il est ouvert tout de suite, pour que la première commande n'attende pas)
PILOTE_WARM_CHROME=

# =============================================================================
# Achat et paiement
# =============================================================================
# Plafond d'un paiement réel en euros (999 par défaut)
PILOTE_MAX_TOTAL_EUR=
# 1 = achat direct : choisir une option vaut ordre d'achat (pas de relecture). Seul garde-fou : le total ne dépasse pas le prix choisi
PILOTE_DIRECT_BUY=
# Code secret à 3 chiffres demandé à l'oral avant chaque achat (achat direct). Vide = pas de code
PILOTE_PURCHASE_CODE=
# 1 = l'agent paie sans callback d'approbation de l'orchestrateur. Laisser vide en démo
PILOTE_AUTO_APPROVE=

# =============================================================================
# Agent H Company
# =============================================================================
# Nom lu automatiquement par le SDK hai-agents (doc H actuelle)
HAI_API_KEY=
# Navigateur de l'agent : user_device (Chrome dédié de l'ordinateur de démo, défaut) ou cloud
PILOTE_BROWSER_HOST=
# Nom d'un agent créé sur la plateforme H (ex. pilote-shopper). Vide = agent défini dans le code (consigne de prompts.py)
PILOTE_H_AGENT=
# Agent du portail H pour les questions (navigateur cloud, sous-agents de lecture), ex. pilote-shopper
PILOTE_H_QUESTION_AGENT=
# Modèle Holo : holo4-27b (défaut, le plus capable) ou holo4-35b-a3b (le plus rapide)
PILOTE_H_MODEL=
# Réflexion avant chaque clic : disabled, low (défaut, plus rapide), medium, xhigh, default
PILOTE_H_REASONING_EFFORT=
# Texte de la page en plus de la capture (0 = coupé ; pas plus rapide sur SNCF)
PILOTE_H_PAGE_TEXT=
# Secondes pendant lesquelles une session H reste ouverte entre deux étapes (900 par défaut, 0 = une session par étape)
PILOTE_H_IDLE_TIMEOUT_S=
# Coffre-fort H (identifiants des sites, saisis par H sans que l'agent les voie). Navigateur cloud seulement
PILOTE_H_VAULT_ID=
# 1 = reprendre le profil de navigateur H par défaut (déjà connecté via python -m orchestrator.agent_h.login_session)
PILOTE_H_DEFAULT_PROFILE=
# Nombre d'options que l'agent cherche (3 par défaut, 8 au maximum)
PILOTE_MAX_OPTIONS=
# Durées de l'agent factice multipliées par ce nombre (1.0 par défaut, 0 = instantané). Tests et développement seulement
PILOTE_FAKE_SPEED=

# =============================================================================
# Sites visés
# =============================================================================
# SNCF Connect : 0 = formulaire Trains au lieu de la recherche rapide « Tout rechercher » (défaut, 2 fois plus rapide)
PILOTE_SNCF_QUICK_SEARCH=
# Site visé par catégorie (adresse complète). Vide = SNCF Connect pour le train, Uber Eats pour le repas
PILOTE_SITE_TRAIN=
PILOTE_SITE_REPAS=
# 1 = plan B de la démo : train et repas passent par les faux sites de l'équipe (Rail Démo, Miam Démo) au lieu de SNCF Connect et Uber Eats
PILOTE_PLAN_B=

# =============================================================================
# Hugging Face : voix → texte, compréhension, vision, texte → voix
# =============================================================================
HF_TOKEN=
# Modèles et réglages (facultatifs, valeurs par défaut dans orchestrator/ai/hf.py)
PILOTE_ASR_MODEL=
PILOTE_LLM_MODEL=
PILOTE_VLM_MODEL=
PILOTE_TTS_MODEL=
PILOTE_TTS_VOICE=
# Fournisseur de la voix en ligne (deepinfra par défaut : fal-ai n'a que des voix anglaises)
PILOTE_TTS_PROVIDER=
# Délai de la voix en ligne Kokoro, en secondes (6 par défaut). Au-delà, la voix du navigateur prend le relais (pas avec une voix locale)
PILOTE_TTS_TIMEOUT_S=
# Voix de Topil : huggingface (Kokoro en ligne, défaut), navigateur (voix de l'ordinateur), ou une voix française locale Kyutai :
# jerem (voix d'homme retenue pour la démo). Les voix locales demandent `pip install -e '.[voix]'` ; sans ce paquet, voix en ligne.
# Avec une voix locale, aucune autre voix ne la remplace : si elle échoue, la phrase reste affichée sans être dite
PILOTE_VOICE=

# =============================================================================
# Mémoire des sites : fichier local par défaut (data/site-cards.json), ou Redis Upstash
# =============================================================================
PILOTE_SITE_MEMORY_PATH=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Interface (web/.env.local)
# =============================================================================
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8000/ws
