# Copier ce fichier en .env.local (ne jamais committer de vraies clés).
# En production, mettre ces valeurs dans les variables d'environnement Vercel.

# Faux site de train sur lequel l'agent H travaille
RAIL_DEMO_URL=https://h-company-hackathon-rail-demo.vercel.app
# Faux site de livraison de repas (à compléter après le déploiement Vercel)
REPAS_DEMO_URL=

# Clé de l'API Agent de H Company
H_API_KEY=

# Jeton Hugging Face (inférence : voix, compréhension, résumé)
HF_TOKEN=

# Fournisseur SMS (à choisir) pour la validation des proches
SMS_API_KEY=
SMS_SENDER=

# Secret pour signer les liens de validation envoyés par SMS
VALIDATION_LINK_SECRET=
