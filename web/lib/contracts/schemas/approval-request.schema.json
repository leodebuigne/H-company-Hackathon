{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilote.local/contracts/approval-request.schema.json",
  "title": "ApprovalRequest",
  "description": "Corps de POST /api/approvals, envoyé par l'orchestrateur à web/ (en-tête Authorization: Bearer PILOTE_SHARED_SECRET).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "user_first_name",
    "site_name",
    "category",
    "summary",
    "relatives",
    "timeout_seconds"
  ],
  "properties": {
    "order_id": {
      "description": "Même valeur que summary.order_id.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "user_first_name": {
      "description": "Prénom de l'utilisateur, affiché dans le SMS.",
      "type": "string",
      "minLength": 1
    },
    "site_name": {
      "description": "Nom du site lisible par un humain (« SNCF Connect »).",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "train",
        "repas",
        "boutique"
      ]
    },
    "summary": {
      "$ref": "order-summary.schema.json"
    },
    "relatives": {
      "description": "Proches à contacter, dans l'ordre. Le n° 1 reçoit le SMS tout de suite, les suivants seulement si le précédent ne répond pas à temps.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first_name",
          "phone"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "description": "Format E.164 (+336...)"
          }
        }
      }
    },
    "timeout_seconds": {
      "description": "Délai laissé à chaque proche avant de passer au suivant. 300 au maximum, plus court pour un repas.",
      "type": "integer",
      "minimum": 10,
      "maximum": 300
    }
  }
}
